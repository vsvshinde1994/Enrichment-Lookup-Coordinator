{
  "name": "enrichment-lookup-coordinator",
  "version": "1.0.0",
  "type": "module",
  "description": "Enrichment Lookup Coordinator with Provider Quota",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run --fileParallelism=false",
    "test:coverage": "vitest run --coverage",
    "test:business-rules": "vitest run tests/businessRules.test.ts",
    "test:watch": "vitest --fileParallelism=false"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
